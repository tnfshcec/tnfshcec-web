{
  "name": "tnfshcec-web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "npm run build:i18n && vite build",
    "build:i18n": "paraglide-js compile --project ./tnfshcec.inlang",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && npx @inlang/cli lint --project ./tnfshcec.inlang",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.1.54",
    "@inlang/paraglide-js": "2.5.0",
    "@melt-ui/pp": "^0.3.0",
    "@melt-ui/svelte": "^0.86.0",
    "@playwright/test": "^1.56.1",
    "@shikijs/transformers": "^1.12.1",
    "@sveltejs/adapter-static": "^3.0.1",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/typography": "^0.5.9",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.1",
    "bits-ui": "^1.8.0",
    "mdsvex": "^0.12.6",
    "mode-watcher": "^0.5.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "rehype-external-links": "^3.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.1.0",
    "svelte": "^5.43.14",
    "svelte-check": "^4.3.4",
    "svelte-meta-tags": "^4.5.0",
    "svelte-preprocess": "^6.0.1",
    "svelte-sequential-preprocessor": "^2.0.1",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.4.1",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.0.0",
    "unplugin-icons": "^22.5.0",
    "vaul-svelte": "^1.0.0-next.3",
    "vite": "^6.4.1"
  },
  "type": "module"
}
